@model ClubRegistration.Mvc.Models.RegisterModel
@{ ViewBag.Title="Регистрация"; }
<section class="auth-card register-card"><div class="auth-emoji">🎁</div><div class="eyebrow red-eyebrow">НОВЫЙ ГОД — НОВЫЕ УВЛЕЧЕНИЯ</div><h1>Создай аккаунт</h1><p class="muted">Это займёт всего минуту.</p>
@using(Html.BeginForm("Register","Account",FormMethod.Post)){@Html.AntiForgeryToken()@Html.ValidationSummary(true,"",new {@class="validation"})<div class="form-grid"><label>@Html.LabelFor(m=>m.LastName)@Html.TextBoxFor(m=>m.LastName)@Html.ValidationMessageFor(m=>m.LastName)</label><label>@Html.LabelFor(m=>m.FirstName)@Html.TextBoxFor(m=>m.FirstName)@Html.ValidationMessageFor(m=>m.FirstName)</label><label>@Html.LabelFor(m=>m.MiddleName)@Html.TextBoxFor(m=>m.MiddleName)</label><label>@Html.LabelFor(m=>m.Email)@Html.TextBoxFor(m=>m.Email,new {@type="email"})@Html.ValidationMessageFor(m=>m.Email)</label><label>@Html.LabelFor(m=>m.Phone)@Html.TextBoxFor(m=>m.Phone,new {@type="tel"})@Html.ValidationMessageFor(m=>m.Phone)</label><label class="account-category-field">@Html.LabelFor(m=>m.AccountCategory)<span class="category-hint">Выберите тип профиля</span>@Html.DropDownListFor(m=>m.AccountCategory,(IEnumerable<SelectListItem>)ViewBag.AccountCategories,"Выберите категорию")@Html.ValidationMessageFor(m=>m.AccountCategory)</label><label>@Html.LabelFor(m=>m.Password)@Html.PasswordFor(m=>m.Password)@Html.ValidationMessageFor(m=>m.Password)</label><label>@Html.LabelFor(m=>m.ConfirmPassword)@Html.PasswordFor(m=>m.ConfirmPassword)@Html.ValidationMessageFor(m=>m.ConfirmPassword)</label></div><button class="button button-red button-wide" type="submit">Зарегистрироваться</button>}
<p class="auth-switch">Уже есть аккаунт? @Html.ActionLink("Войти","Login")</p></section>
