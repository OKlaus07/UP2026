@model IList<ClubRegistration.Mvc.Models.EnrollmentRow>
@{ ViewBag.Title="Мои заявки"; }
<section class="simple-page"><div class="eyebrow red-eyebrow">МОЙ ЛИЧНЫЙ КАБИНЕТ</div><h1>Мои заявки <span>📬</span></h1><p class="muted">Следи за статусом и не пропускай хорошие новости.</p>
@if(Model.Count==0){<div class="empty-state">Здесь пока нет заявок. Самое время найти новое увлечение! <a href="@Url.Action("Index")">Открыть каталог</a></div>}
<div class="table-wrap"><table><thead><tr><th>Кружок</th><th>Дата подачи</th><th>Статус</th><th></th></tr></thead><tbody>
@foreach(var item in Model){<tr><td><strong>@item.ClubName</strong></td><td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td><span class="status">@item.Status</span></td><td>@if(item.Status=="Ожидает рассмотрения"){using(Html.BeginForm("Cancel","Clubs",FormMethod.Post,new {@class="inline-form"})){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><button class="button button-quiet" type="submit">Отменить</button>}}</td></tr>}
</tbody></table></div></section>
