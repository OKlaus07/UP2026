@model ClubRegistration.Mvc.Models.ProfileModel
@{ViewBag.Title="Мой профиль";}
<section class="simple-page"><div class="eyebrow red-eyebrow">МОЙ УЮТНЫЙ УГОЛОК</div><h1>Мой профиль <span>🧤</span></h1>
<div class="profile-grid"><section class="auth-card profile-card"><h2>Личные данные</h2>@using(Html.BeginForm("Save","Profile",FormMethod.Post)){@Html.AntiForgeryToken()@Html.ValidationSummary(true,"",new {@class="validation"})<label>@Html.LabelFor(m=>m.LastName)@Html.TextBoxFor(m=>m.LastName)@Html.ValidationMessageFor(m=>m.LastName)</label><label>@Html.LabelFor(m=>m.FirstName)@Html.TextBoxFor(m=>m.FirstName)@Html.ValidationMessageFor(m=>m.FirstName)</label><label>@Html.LabelFor(m=>m.MiddleName)@Html.TextBoxFor(m=>m.MiddleName)</label><label>@Html.LabelFor(m=>m.Phone)@Html.TextBoxFor(m=>m.Phone)</label><label>@Html.LabelFor(m=>m.Email)@Html.TextBoxFor(m=>m.Email,new {@readonly="readonly"})</label><button class="button button-green button-wide" type="submit">Сохранить данные</button>}</section>
<section class="auth-card profile-card"><div class="auth-emoji">🔐</div><h2>Сменить пароль</h2>@using(Html.BeginForm("ChangePassword","Profile",FormMethod.Post)){@Html.AntiForgeryToken()<label>Старый пароль<input type="password" name="OldPassword" autocomplete="current-password" required /></label><label>Новый пароль<input type="password" name="NewPassword" minlength="8" autocomplete="new-password" required /></label><label>Повторите новый пароль<input type="password" name="ConfirmPassword" minlength="8" autocomplete="new-password" required /></label><button class="button button-red button-wide" type="submit">Обновить пароль</button>}</section></div></section>
